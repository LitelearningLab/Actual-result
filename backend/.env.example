# ==============================================================================
# Actual-Result Backend Environment Configuration Template
# ==============================================================================

# Database Configuration (SQL Server)
DB_SERVER=your_sql_server
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password
DB_DRIVER=ODBC Driver 17 for SQL Server

# Google Cloud Storage (GCS) Configuration
GCS_BUCKET_NAME=your_gcs_bucket_name
GCS_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# GCS URL Strategy:
# Set GCS_USE_SIGNED_URLS=true for private buckets with time-limited signed URLs
# Set GCS_USE_SIGNED_URLS=false if using public bucket objects or CDN base URL
GCS_USE_SIGNED_URLS=false
GCS_SIGNED_URL_EXPIRATION_MINUTES=1440

# Optional custom CDN or public domain base (e.g., https://media.yourdomain.com)
GCS_PUBLIC_URL_BASE=

# Production Safety Guard:
# When GCS_BUCKET_NAME is configured, set ALLOW_LOCAL_FALLBACK=false in production
# to prevent silent fallback to ephemeral local container disk if GCP credentials fail.
ALLOW_LOCAL_FALLBACK=false

# Media Size Limits
MAX_IMAGE_SIZE_BYTES=15728640   # 15 MB
MAX_AUDIO_SIZE_BYTES=31457280   # 30 MB

# Server & Security
SECRET_KEY=your_secret_key_here
PORT=5000
ENVIRONMENT=production
